    <rdf:Description rdf:about="http://arxiv.org/abs/2602.12499">
        <z:itemType>preprint</z:itemType>
        <dc:publisher>
           <foaf:Organization><foaf:name>arXiv</foaf:name></foaf:Organization>
        </dc:publisher>
        <bib:authors>
            <rdf:Seq>
                <rdf:li>
                    <foaf:Person>
                        <foaf:surname>Shandirasegaran</foaf:surname>
                        <foaf:givenName>Mugunthan</foaf:givenName>
                    </foaf:Person>
                </rdf:li>

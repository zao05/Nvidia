               <rdf:value>http://arxiv.org/abs/2101.03961</rdf:value>
            </dcterms:URI>
        </dc:identifier>
        <dcterms:dateSubmitted>2026-05-20 08:34:39</dcterms:dateSubmitted>
        <z:shortTitle>Switch Transformers</z:shortTitle>
        <z:libraryCatalog>arXiv.org</z:libraryCatalog>
